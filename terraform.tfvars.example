# AWS Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "travel-site"
environment  = "dev"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# EKS Configuration
eks_cluster_version    = "1.29"
eks_node_instance_type = "t3.medium"
eks_node_min_size      = 2
eks_node_max_size      = 5
eks_node_desired_size  = 2

# RDS Configuration
db_instance_class = "db.t3.micro"
db_name           = "travel_site"
db_username       = "dbadmin"
db_password       = "CHANGE_ME_use_a_strong_password"

# CloudFront (placeholder - update after creating CloudFront distribution)
cloudfront_oai_arn = ""
